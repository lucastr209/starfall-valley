{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "regions": ["sin1"],
  "fluid": true,
  "public": false,
  "functions": { "api/play.mjs": { "maxDuration": 300 } },
  "rewrites": [
    { "source": "/play", "destination": "/api/play" },
    { "source": "/health", "destination": "/api/play" }
  ],
  "headers": [{
    "source": "/(.*)",
    "headers": [
      { "key": "Content-Security-Policy", "value": "default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; manifest-src 'self'; connect-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'" },
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "no-referrer" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=(), payment=(), fullscreen=(self)" },
      { "key": "Cache-Control", "value": "no-cache" }
    ]
  }, {"source":"/recovery/forest-checkpoint.json","headers":[{"key":"Content-Disposition","value":"attachment; filename=\"starfall-valley-forest-recovery.json\""}]}, {"source":"/recovery/cave-checkpoint.json","headers":[{"key":"Content-Disposition","value":"attachment; filename=\"starfall-valley-cave-checkpoint.json\""}]}]
}
