# Cấu hình công khai của client; chỉ WSS, không chứa token.
ONLINE_WS_URL=

# Vercel Marketplace provision these server-only credentials. Never put them in client-config.js.
REDIS_URL=
ONLINE_IP_SALT=
# Server: danh sách origin HTTPS chính xác, ngăn cách bằng dấu phẩy.
ALLOWED_ORIGINS=
# Thiết lập giới hạn cho một server Node chạy thường trực.
MAX_CLIENTS=60
MAX_CONNECTIONS_PER_IP=8
# Chỉ điền IP/CIDR của reverse proxy tin cậy ghi đè X-Real-IP.
TRUSTED_PROXY_IPS=
HOST=0.0.0.0
PORT=4173

# Thức Tỉnh: public frontend dùng origin HTTPS của backend Render.
COOP_SERVER_URL=
# Chỉ URL và anon key được công khai; service_role tuyệt đối chỉ đặt trên backend.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# QA chỉ được bật cùng HOST=127.0.0.1, tuyệt đối không dùng ở production.
COOP_QA=0
